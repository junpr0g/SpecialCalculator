<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SpecialCalculator.AppSettingsPage"
             Title="Sovellusasetukset"
             BackgroundColor="#F4F8F4">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Border BackgroundColor="#E8F0E8"
                    Stroke="#CEDDCE"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label x:Name="PageTitleLabel"
                           Text="Sovellusasetukset"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#1F5A3B" />

                    <Label x:Name="LanguageLabel"
                           Text="Kieli"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#2F4736" />
                    <Border BackgroundColor="#F7FBF7"
                            Stroke="#2F6B4A"
                            StrokeThickness="1.2"
                            StrokeShape="RoundRectangle 10"
                            Padding="10,4">
                        <Picker x:Name="LanguagePicker"
                                BackgroundColor="Transparent"
                                TextColor="#153D2B"
                                TitleColor="#90A39A"
                                FontSize="15"
                                HeightRequest="44" />
                    </Border>

                    <Label x:Name="ThemeLabel"
                           Text="Teema"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#2F4736"
                           Margin="0,8,0,0" />
                    <Border BackgroundColor="#F7FBF7"
                            Stroke="#2F6B4A"
                            StrokeThickness="1.2"
                            StrokeShape="RoundRectangle 10"
                            Padding="10,4">
                        <Picker x:Name="ThemePicker"
                                BackgroundColor="Transparent"
                                TextColor="#153D2B"
                                TitleColor="#90A39A"
                                FontSize="15"
                                HeightRequest="44" />
                    </Border>

                    <Button x:Name="SaveButton"
                            Text="Tallenna"
                            Clicked="OnSaveClicked"
                            BackgroundColor="#1F5A3B"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="38"
                            FontSize="13"
                            Padding="14,0"
                            HorizontalOptions="Start"
                            Margin="0,10,0,0" />

                    <Label x:Name="StatusLabel"
                           TextColor="#2F6B4A"
                           FontSize="12"
                           IsVisible="False" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
