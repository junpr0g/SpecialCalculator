@page "/not-found"
@layout MainLayout
@inject LocalizationService Localization

<div class="mx-auto max-w-app px-4 py-16 text-center">
    <h1 class="text-2xl font-bold text-calc-primary">404</h1>
    <p class="mt-2 text-calc-secondary">@Localization.T("header_subtitle")</p>
    <a href="/" class="calc-btn-secondary mt-6 inline-flex">@Localization.T("header_subtitle")</a>
</div>
