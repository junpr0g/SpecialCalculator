@page "/"
@implements IDisposable
@inject CalculatorSettingsStore SettingsStore
@inject LocalizationService Localization
@inject AppThemeService ThemeService
@inject AppPreferencesStore Preferences
@inject NavigationManager Navigation

<div @onclick="CloseDropdowns" class="flex min-h-dvh flex-col justify-center">
    <div class="mx-auto w-full max-w-app px-4 py-6 calc-lg:py-10">
        <div class="flex flex-col gap-4">
            <!-- Header -->
            <div class="flex min-h-[100px] items-center rounded-calc border border-calc-stroke bg-calc-header p-2.5">
                <div class="flex flex-1 flex-col gap-0.5">
                    <h1 class="text-xl font-bold text-calc-primary">@Localization.T("header_title")</h1>
                    <p class="text-sm text-calc-secondary">@Localization.T("header_subtitle")</p>
                </div>
                <button type="button"
                        class="calc-btn-secondary shrink-0"
                        @onclick="OpenSettings"
                        @onclick:stopPropagation="true">
                    @Localization.T("settings")
                </button>
            </div>

            <!-- Cards grid -->
            <div class="grid grid-cols-1 gap-3 calc-lg:grid-cols-2 calc-lg:gap-3">
                <!-- Results card -->
                <div class="calc-card">
                    <h2 class="mb-2 text-xl font-bold text-calc-primary">@Localization.T("results_title")</h2>

                    <div class="flex flex-col gap-2">
                        <div class="flex items-center justify-between">
                            <span class="text-calc-primary">@Localization.T("work_net")</span>
                            <span class="font-bold text-calc-primary">@FormatEuro(_result.WorkCost)</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-calc-primary">@Localization.T("travel_net")</span>
                            <span class="font-bold text-calc-primary">@FormatEuro(_result.TravelCost)</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-calc-primary">@Localization.T("subtotal_net")</span>
                            <span class="font-bold text-calc-primary">@FormatEuro(_result.Subtotal)</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-calc-primary">@VatCaption</span>
                            <span class="font-bold text-calc-primary">@FormatEuro(_result.VatAmount)</span>
                        </div>
                    </div>

                    <div class="mt-2 rounded-calc-sm bg-calc-total p-3">
                        <div class="flex items-center justify-between">
                            <span class="text-xl font-bold text-calc-primary">@Localization.T("total")</span>
                            <span class="text-[28px] font-bold text-calc-primary">@FormatEuro(_result.Total)</span>
                        </div>
                    </div>
                </div>

                <!-- Input card -->
                <div class="calc-card-alt">
                    <div class="mb-2.5 flex items-center justify-between gap-3">
                        <h2 class="text-xl font-bold text-calc-primary">@Localization.T("input_title")</h2>
                        <button type="button" class="calc-btn-secondary" @onclick="ResetInputs" @onclick:stopPropagation="true">
                            @Localization.T("clear")
                        </button>
                    </div>

                    <div class="flex flex-col gap-2.5">
                        <div>
                            <label class="calc-section-label mb-1.5 block">@Localization.T("select_work")</label>
                            <RateDropdown Rates="_hourlyRates"
                                          Unit="h"
                                          Selected="_selectedHourly"
                                          SelectedChanged="OnHourlySelected"
                                          IsOpen="_hourlyDropdownOpen"
                                          IsOpenChanged="OnHourlyDropdownOpenChanged" />
                        </div>

                        <div>
                            <label class="calc-section-label mb-1.5 block">@Localization.T("select_travel")</label>
                            <RateDropdown Rates="_mileageRates"
                                          Unit="km"
                                          Selected="_selectedMileage"
                                          SelectedChanged="OnMileageSelected"
                                          IsOpen="_mileageDropdownOpen"
                                          IsOpenChanged="OnMileageDropdownOpenChanged" />
                        </div>

                        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                            <div>
                                <label class="calc-section-label mb-1.5 block" for="hours-input">@Localization.T("hours")</label>
                                <div class="calc-input-border">
                                    <input id="hours-input"
                                           type="text"
                                           inputmode="decimal"
                                           placeholder="0"
                                           class="calc-input"
                                           @bind="_hoursText"
                                           @bind:event="oninput"
                                           @bind:after="CalculateAndRender"
                                           @onfocus="CloseDropdowns" />
                                </div>
                            </div>
                            <div>
                                <label class="calc-section-label mb-1.5 block" for="km-input">@Localization.T("kilometers")</label>
                                <div class="calc-input-border">
                                    <input id="km-input"
                                           type="text"
                                           inputmode="decimal"
                                           placeholder="0"
                                           class="calc-input"
                                           @bind="_kilometersText"
                                           @bind:event="oninput"
                                           @bind:after="CalculateAndRender"
                                           @onfocus="CloseDropdowns" />
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(_validationMessage))
                        {
                            <p class="text-xs text-calc-error">@_validationMessage</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<RateItem> _hourlyRates = [];
    private List<RateItem> _mileageRates = [];
    private decimal _vatPercent;
    private RateItem? _selectedHourly;
    private RateItem? _selectedMileage;
    private int _selectedHourlyIndex;
    private int _selectedMileageIndex = 1;
    private string _hoursText = string.Empty;
    private string _kilometersText = string.Empty;
    private string _validationMessage = string.Empty;
    private bool _hourlyDropdownOpen;
    private bool _mileageDropdownOpen;
    private CalculatorEngine.CalculationResult _result = new(0, 0, 0, 0, 0);

    private string VatCaption =>
        $"{Localization.T("vat_label")} ({CalculatorEngine.FormatVatPercent(_vatPercent)} %)";

    protected override async Task OnInitializedAsync()
    {
        ThemeService.ThemeChanged += OnThemeChanged;
        Preferences.PreferencesChanged += OnPreferencesChanged;
        await ReloadSettingsAsync();
        CalculateAndRender();
    }

    protected override async Task OnParametersSetAsync()
    {
        await ReloadSettingsAsync();
        CalculateAndRender();
    }

    private void OnThemeChanged() => _ = InvokeAsync(async () =>
    {
        await ReloadSettingsAsync();
        CalculateAndRender();
        StateHasChanged();
    });

    private void OnPreferencesChanged() => _ = InvokeAsync(() =>
    {
        CalculateAndRender();
        StateHasChanged();
        return Task.CompletedTask;
    });

    private async Task ReloadSettingsAsync()
    {
        CalculatorSettings settings = await SettingsStore.LoadAsync();
        _hourlyRates = settings.HourlyRates;
        _mileageRates = settings.MileageRates;
        _vatPercent = settings.VatPercent;

        if (_hourlyRates.Count == 0 || _mileageRates.Count == 0)
        {
            CalculatorSettings fallback = CalculatorSettingsStore.Clone(SettingsStore.Defaults);
            _hourlyRates = fallback.HourlyRates;
            _mileageRates = fallback.MileageRates;
            _vatPercent = fallback.VatPercent;
        }

        _selectedHourlyIndex = Math.Clamp(_selectedHourlyIndex, 0, _hourlyRates.Count - 1);
        _selectedMileageIndex = Math.Clamp(_selectedMileageIndex, 0, _mileageRates.Count - 1);
        _selectedHourly = _hourlyRates[_selectedHourlyIndex];
        _selectedMileage = _mileageRates[_selectedMileageIndex];
    }

    private void CalculateAndRender()
    {
        if (!CalculatorEngine.TryValidate(_hoursText, _kilometersText, Localization, out decimal hours, out decimal kilometers, out string validationMessage))
        {
            _validationMessage = validationMessage;
            return;
        }

        _validationMessage = string.Empty;

        decimal hourlyRate = CalculatorEngine.GetSelectedRate(_hourlyRates, _selectedHourlyIndex, 0);
        decimal mileageRate = CalculatorEngine.GetSelectedRate(_mileageRates, _selectedMileageIndex, 0);
        _result = CalculatorEngine.Calculate(hours, kilometers, hourlyRate, mileageRate, _vatPercent);
    }

    private static string FormatEuro(decimal value) => CalculatorEngine.FormatEuro(value);

    private void OnHourlySelected(RateItem selected)
    {
        _selectedHourlyIndex = _hourlyRates.FindIndex(x => x.Id == selected.Id);
        if (_selectedHourlyIndex < 0) _selectedHourlyIndex = 0;
        _selectedHourly = _hourlyRates[_selectedHourlyIndex];
        CalculateAndRender();
    }

    private void OnMileageSelected(RateItem selected)
    {
        _selectedMileageIndex = _mileageRates.FindIndex(x => x.Id == selected.Id);
        if (_selectedMileageIndex < 0) _selectedMileageIndex = 0;
        _selectedMileage = _mileageRates[_selectedMileageIndex];
        CalculateAndRender();
    }

    private Task OnHourlyDropdownOpenChanged(bool isOpen)
    {
        _hourlyDropdownOpen = isOpen;
        if (isOpen) _mileageDropdownOpen = false;
        return Task.CompletedTask;
    }

    private Task OnMileageDropdownOpenChanged(bool isOpen)
    {
        _mileageDropdownOpen = isOpen;
        if (isOpen) _hourlyDropdownOpen = false;
        return Task.CompletedTask;
    }

    private void CloseDropdowns()
    {
        _hourlyDropdownOpen = false;
        _mileageDropdownOpen = false;
    }

    private void ResetInputs()
    {
        _hoursText = string.Empty;
        _kilometersText = string.Empty;
        _selectedHourlyIndex = 0;
        _selectedMileageIndex = Math.Min(1, _mileageRates.Count - 1);
        _selectedHourly = _hourlyRates[_selectedHourlyIndex];
        _selectedMileage = _mileageRates[_selectedMileageIndex];
        _validationMessage = string.Empty;
        CloseDropdowns();
        CalculateAndRender();
    }

    private void OpenSettings() => Navigation.NavigateTo("/settings");

    public void Dispose()
    {
        ThemeService.ThemeChanged -= OnThemeChanged;
        Preferences.PreferencesChanged -= OnPreferencesChanged;
    }
}
