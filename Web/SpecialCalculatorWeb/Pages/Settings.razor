@page "/settings"
@implements IDisposable
@inject CalculatorSettingsStore SettingsStore
@inject LocalizationService Localization
@inject AppThemeService ThemeService
@inject AppPreferencesStore Preferences
@inject NavigationManager Navigation
@using System.Globalization

<div class="mx-auto max-w-app px-4 py-4">
    <div class="mb-3 flex items-center gap-3">
        <button type="button" class="calc-btn-secondary" @onclick="GoBack">
            ← @Localization.T("header_subtitle")
        </button>
    </div>
    <div class="flex flex-col gap-3">
        <!-- Tab bar -->
        <div class="rounded-calc border border-calc-stroke bg-calc-tab-bar p-1">
            <div class="grid grid-cols-2 gap-1">
                <button type="button"
                        class="@AdminTabClass"
                        @onclick="() => SelectTab(0)">
                    @Localization.T("tab_admin")
                </button>
                <button type="button"
                        class="@AppTabClass"
                        @onclick="() => SelectTab(1)">
                    @Localization.T("tab_app")
                </button>
            </div>
        </div>

        <!-- Tab panels -->
        @if (_activeTab == 0)
        {
            <div class="rounded-calc border border-calc-stroke bg-calc-admin-panel p-4">
                <h2 class="mb-3 text-[22px] font-bold text-calc-primary">@Localization.T("admin_settings_title")</h2>

                <p class="mb-2 text-[15px] font-bold text-calc-body">@Localization.T("hourly_rates")</p>
                <div class="mb-2 flex flex-col gap-2.5">
                    @foreach (RateItem rate in _settings.HourlyRates)
                    {
                        <div class="grid grid-cols-[1fr_auto] items-center gap-2.5">
                            <span class="text-[15px] text-calc-body">@AdminRateName(rate)</span>
                            <div class="calc-input-border w-28">
                                <input type="text"
                                       inputmode="decimal"
                                       class="calc-input h-9 text-left text-[15px]"
                                       @bind="_hourlyValues[rate.Id]"
                                       @bind:event="oninput" />
                            </div>
                        </div>
                    }
                </div>

                <p class="mb-2 mt-2 text-[15px] font-bold text-calc-body">@Localization.T("mileage_rates")</p>
                <div class="mb-2 flex flex-col gap-2.5">
                    @foreach (RateItem rate in _settings.MileageRates)
                    {
                        <div class="grid grid-cols-[1fr_auto] items-center gap-2.5">
                            <span class="text-[15px] text-calc-body">@AdminRateName(rate)</span>
                            <div class="calc-input-border w-28">
                                <input type="text"
                                       inputmode="decimal"
                                       class="calc-input h-9 text-left text-[15px]"
                                       @bind="_mileageValues[rate.Id]"
                                       @bind:event="oninput" />
                            </div>
                        </div>
                    }
                </div>

                <p class="mb-2 mt-2 text-[15px] font-bold text-calc-body">@Localization.T("vat_label") (%)</p>
                <div class="calc-input-border max-w-xs">
                    <input type="text"
                           inputmode="decimal"
                           placeholder="25,5"
                           class="calc-input text-[15px]"
                           @bind="_vatText"
                           @bind:event="oninput" />
                </div>

                <div class="mt-2.5 flex flex-wrap gap-2.5">
                    <button type="button" class="calc-btn-primary" @onclick="SaveAdminSettings">
                        @Localization.T("save")
                    </button>
                    <button type="button" class="calc-btn-secondary" @onclick="ResetDefaults">
                        @Localization.T("reset_defaults")
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(_adminStatus))
                {
                    <p class="mt-2 text-xs @(_adminStatusIsError ? "text-calc-error" : "text-calc-success")">@_adminStatus</p>
                }
            </div>
        }
        else
        {
            <div class="rounded-calc border border-calc-app-input-stroke bg-calc-app-panel p-4">
                <h2 class="mb-2.5 text-xl font-bold text-calc-app-primary">@Localization.T("app_settings_title")</h2>

                <p class="calc-section-label mb-2 text-calc-app-body">@Localization.T("language")</p>
                <div class="rounded-calc-sm border border-calc-app-input-stroke bg-calc-app-input px-2.5 py-1">
                    <select class="h-11 w-full bg-transparent text-[15px] text-calc-app-picker focus:outline-none"
                            @bind="_languageIndex"
                            @bind:after="ApplyLanguageAsync">
                        <option value="0">@Localization.T("language_fi")</option>
                        <option value="1">@Localization.T("language_en")</option>
                    </select>
                </div>

                <p class="calc-section-label mb-2 mt-2 text-calc-app-body">@Localization.T("theme")</p>
                <div class="rounded-calc-sm border border-calc-app-input-stroke bg-calc-app-input px-2.5 py-1">
                    <select class="h-11 w-full bg-transparent text-[15px] text-calc-app-picker focus:outline-none"
                            @bind="_themeIndex"
                            @bind:after="ApplyThemeAsync">
                        <option value="0">@Localization.T("theme_light")</option>
                        <option value="1">@Localization.T("theme_dark")</option>
                    </select>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private static readonly CultureInfo FiCulture = CultureInfo.GetCultureInfo("fi-FI");

    private int _activeTab;
    private CalculatorSettings _settings = new();
    private Dictionary<string, string> _hourlyValues = [];
    private Dictionary<string, string> _mileageValues = [];
    private string _vatText = string.Empty;
    private int _languageIndex;
    private int _themeIndex;
    private string _adminStatus = string.Empty;
    private bool _adminStatusIsError;

    private string AdminTabClass =>
        _activeTab == 0
            ? "h-10 rounded-calc-xs bg-calc-admin-tab-active text-[13px] font-bold text-calc-primary"
            : "h-10 rounded-calc-xs bg-transparent text-[13px] text-calc-secondary";

    private string AppTabClass =>
        _activeTab == 1
            ? "h-10 rounded-calc-xs bg-calc-app-tab-active text-[13px] font-bold text-calc-app-tab-active-text"
            : "h-10 rounded-calc-xs bg-transparent text-[13px] text-calc-secondary";

    protected override async Task OnInitializedAsync()
    {
        ThemeService.ThemeChanged += OnThemeChanged;
        Preferences.PreferencesChanged += OnPreferencesChanged;
        await LoadAllAsync();
    }

    private void OnThemeChanged() => _ = InvokeAsync(async () =>
    {
        await LoadAllAsync();
        StateHasChanged();
    });

    private void OnPreferencesChanged() => _ = InvokeAsync(() =>
    {
        StateHasChanged();
        return Task.CompletedTask;
    });

    private async Task LoadAllAsync()
    {
        _settings = await SettingsStore.LoadAsync();
        BuildAdminInputs();
        BuildAppPickers();
    }

    private void BuildAdminInputs()
    {
        _hourlyValues = _settings.HourlyRates.ToDictionary(
            r => r.Id,
            r => r.Value == 0m ? string.Empty : r.Value.ToString("0.##", FiCulture));

        _mileageValues = _settings.MileageRates.ToDictionary(
            r => r.Id,
            r => r.Value == 0m ? string.Empty : r.Value.ToString("0.##", FiCulture));

        _vatText = _settings.VatPercent.ToString("0.##", FiCulture);
        _adminStatus = string.Empty;
    }

    private void BuildAppPickers()
    {
        _languageIndex = Preferences.Language == "en" ? 1 : 0;
        _themeIndex = Preferences.Theme == ThemeMode.Dark ? 1 : 0;
    }

    private static string AdminRateName(RateItem rate, LocalizationService localization)
    {
        string name = localization.RateName(rate);
        if (string.IsNullOrWhiteSpace(name))
        {
            return name;
        }

        return string.Join(' ',
            name.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Select(static word => char.ToUpper(word[0]) + word[1..]));
    }

    private string AdminRateName(RateItem rate) => AdminRateName(rate, Localization);

    private void SelectTab(int index) => _activeTab = index;

    private void GoBack() => Navigation.NavigateTo("/");

    private async Task SaveAdminSettings()
    {
        if (!TryCollectAdminSettings(out CalculatorSettings? updated, out string validation))
        {
            _adminStatus = validation;
            _adminStatusIsError = true;
            return;
        }

        await SettingsStore.SaveAsync(updated!);
        _settings = CalculatorSettingsStore.Clone(updated!);
        _adminStatus = Localization.T("saved");
        _adminStatusIsError = false;
    }

    private async Task ResetDefaults()
    {
        await SettingsStore.ResetToDefaultsAsync();
        _settings = CalculatorSettingsStore.Clone(SettingsStore.Defaults);
        BuildAdminInputs();
        _adminStatus = Localization.T("defaults_restored");
        _adminStatusIsError = false;
    }

    private async Task ApplyLanguageAsync()
    {
        string language = _languageIndex == 1 ? "en" : "fi";
        await Preferences.SetLanguageAsync(language);
    }

    private async Task ApplyThemeAsync()
    {
        ThemeMode theme = _themeIndex == 1 ? ThemeMode.Dark : ThemeMode.Light;
        await ThemeService.SetThemeAsync(theme);
    }

    private bool TryCollectAdminSettings(out CalculatorSettings? settings, out string validation)
    {
        List<RateItem> hourly = [];
        foreach (RateItem rate in _settings.HourlyRates)
        {
            decimal value = CalculatorEngine.ParseDecimal(_hourlyValues[rate.Id]);
            if (value < 0)
            {
                settings = null;
                validation = Localization.T("invalid_hourly_rate").Replace("{name}", Localization.RateName(rate));
                return false;
            }

            hourly.Add(new RateItem(rate.Id, rate.Name, value));
        }

        List<RateItem> mileage = [];
        foreach (RateItem rate in _settings.MileageRates)
        {
            decimal value = CalculatorEngine.ParseDecimal(_mileageValues[rate.Id]);
            if (value < 0)
            {
                settings = null;
                validation = Localization.T("invalid_mileage_rate").Replace("{name}", Localization.RateName(rate));
                return false;
            }

            mileage.Add(new RateItem(rate.Id, rate.Name, value));
        }

        decimal vat = CalculatorEngine.ParseDecimal(_vatText);
        if (vat < 0)
        {
            settings = null;
            validation = Localization.T("invalid_vat");
            return false;
        }

        settings = new CalculatorSettings
        {
            HourlyRates = hourly,
            MileageRates = mileage,
            VatPercent = vat
        };
        validation = string.Empty;
        return true;
    }

    public void Dispose()
    {
        ThemeService.ThemeChanged -= OnThemeChanged;
        Preferences.PreferencesChanged -= OnPreferencesChanged;
    }
}
