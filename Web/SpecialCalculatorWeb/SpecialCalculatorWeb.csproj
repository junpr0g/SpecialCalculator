<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <RootNamespace>SpecialCalculatorWeb</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.8" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <Target Name="BuildTailwindCss" BeforeTargets="Build">
    <Exec Command="tailwindcss.exe -i ./Styles/input.css -o ./wwwroot/css/tailwind.css --minify"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          Condition="Exists('$(MSBuildProjectDirectory)\tailwindcss.exe')" />
    <Exec Command="npm run build:css"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          Condition="!Exists('$(MSBuildProjectDirectory)\tailwindcss.exe') And Exists('$(MSBuildProjectDirectory)\package.json')" />
  </Target>

</Project>
