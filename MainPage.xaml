<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SpecialCalculator.MainPage"
             BackgroundColor="{DynamicResource CalcPageBackground}">
    <ContentPage.Resources>
        <Style x:Key="InputBorderStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{DynamicResource CalcInputBackground}" />
            <Setter Property="Stroke" Value="{DynamicResource CalcAccentStroke}" />
            <Setter Property="StrokeThickness" Value="1.2" />
            <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            <Setter Property="Padding" Value="10,4" />
        </Style>

        <Style x:Key="InputEntryStyle" TargetType="Entry">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{DynamicResource CalcInputText}" />
            <Setter Property="PlaceholderColor" Value="{DynamicResource CalcPlaceholder}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="HeightRequest" Value="44" />
        </Style>

        <Style x:Key="DropdownHeaderTextStyle" TargetType="Label">
            <Setter Property="TextColor" Value="{DynamicResource CalcInputText}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="LineBreakMode" Value="TailTruncation" />
        </Style>

        <Style x:Key="DropdownOptionTextStyle" TargetType="Label">
            <Setter Property="TextColor" Value="{DynamicResource CalcDropdownOptionText}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>

        <Style x:Key="PrimaryLabelStyle" TargetType="Label">
            <Setter Property="TextColor" Value="{DynamicResource CalcPrimaryText}" />
        </Style>

        <Style x:Key="BodyLabelStyle" TargetType="Label">
            <Setter Property="TextColor" Value="{DynamicResource CalcBodyText}" />
        </Style>

        <Style x:Key="SecondaryActionButtonStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{DynamicResource CalcButtonBackground}" />
            <Setter Property="TextColor" Value="{DynamicResource CalcPrimaryText}" />
            <Setter Property="BorderColor" Value="{DynamicResource CalcAccentStroke}" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HeightRequest" Value="36" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
    </ContentPage.Resources>
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">
            
            <Border BackgroundColor="{DynamicResource CalcHeaderBackground}"
                    Stroke="{DynamicResource CalcStroke}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    HeightRequest="100"
                    Padding="10">

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="2">
                            <Label x:Name="HeaderTitleLabel"
                                   Text="Lapin Koti- ja Mökkiyhdistys ry"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource CalcPrimaryText}" />
                        <Label x:Name="HeaderSubtitleLabel"
                               Text="Palvelukustannuslaskuri"
                               FontSize="14"
                               TextColor="{DynamicResource CalcSecondaryText}" />
                    </VerticalStackLayout>

                    <Button x:Name="OpenSettingsButton"
                            Grid.Column="1"
                            Text="Asetukset"
                            Clicked="OnOpenSettingsClicked"
                            Style="{StaticResource SecondaryActionButtonStyle}"
                            VerticalOptions="Center"
                            HorizontalOptions="End"
                            SemanticProperties.Hint="Avaa ylläpidon asetukset" />
                </Grid>
            </Border>

            <Grid x:Name="CardsGrid"
                  ColumnDefinitions="*"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="12"
                  RowSpacing="12">
                <Border x:Name="ResultsCard"
                        Grid.Row="0"
                        BackgroundColor="{DynamicResource CalcCardBackground}"
                        Stroke="{DynamicResource CalcStroke}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label x:Name="ResultsTitleLabel"
                               Text="Laskelman erittely"
                   FontSize="20"
                   FontAttributes="Bold"
                   Style="{StaticResource PrimaryLabelStyle}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label x:Name="WorkCaptionLabel" Style="{StaticResource PrimaryLabelStyle}" />
                            <Label x:Name="WorkValueLabel"
                   Grid.Column="1"
                   FontAttributes="Bold"
                   Style="{StaticResource PrimaryLabelStyle}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label x:Name="TravelCaptionLabel" Style="{StaticResource PrimaryLabelStyle}" />
                            <Label x:Name="TravelValueLabel"
                   Grid.Column="1"
                   FontAttributes="Bold" 
                   Style="{StaticResource PrimaryLabelStyle}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label x:Name="SubtotalCaptionLabel" Style="{StaticResource PrimaryLabelStyle}"/>
                            <Label x:Name="SubtotalValueLabel"
                   Grid.Column="1"
                   FontAttributes="Bold"
                   Style="{StaticResource PrimaryLabelStyle}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label x:Name="VatCaptionLabel" Style="{StaticResource PrimaryLabelStyle}"/>
                            <Label x:Name="VatValueLabel"
                   Grid.Column="1"
                   FontAttributes="Bold"
                   Style="{StaticResource PrimaryLabelStyle}"/>
                        </Grid>

                        <Border x:Name="TotalBandBorder"
                                BackgroundColor="{DynamicResource CalcTotalBand}"
                StrokeShape="RoundRectangle 10"
                Padding="12"
                Margin="0,8,0,0">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="YHTEENSÄ"
                                       VerticalTextAlignment="Center"
                                       x:Name="TotalCaptionLabel"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       Style="{StaticResource PrimaryLabelStyle}" />
                                <Label x:Name="TotalValueLabel"
                                       Grid.Column="1"
                                       FontSize="28"
                                       FontAttributes="Bold"
                                       Style="{StaticResource PrimaryLabelStyle}" />       
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="InputCard"
                        Grid.Row="1"
                        BackgroundColor="{DynamicResource CalcCardAltBackground}"
                        Stroke="{DynamicResource CalcStroke}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="12">
                            <Label x:Name="InputTitleLabel"
                                   Text="Syötä tiedot"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   Style="{StaticResource PrimaryLabelStyle}"
                                   VerticalOptions="Center" />
                            <Button x:Name="ClearInputsButton"
                                    Grid.Column="1"
                                    Text="Tyhjennä"
                                    Clicked="OnResetClicked"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    VerticalOptions="Center"
                                    HorizontalOptions="End"
                                    SemanticProperties.Hint="Tyhjentää syötetyt arvot ja palauttaa oletukset" />
                        </Grid>

                        <Label x:Name="WorkTypeLabel"
                               Text="Valitse työtyyppi"
                               FontSize="14"
                               FontAttributes="Bold"
                               Style="{StaticResource BodyLabelStyle}" />
                        <Border Style="{StaticResource InputBorderStyle}" Padding="10,0">
                            <Grid RowDefinitions="44,Auto">
                                <Grid HeightRequest="44">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnHourlyDropdownTapped" />
                                    </Grid.GestureRecognizers>
                                    <Label x:Name="HourlySelectedLabel"
                                           Style="{StaticResource DropdownHeaderTextStyle}" />
                                    <Label Text="▼"
                                           HorizontalOptions="End"
                                           VerticalOptions="Center"
                                           TextColor="{DynamicResource CalcAccentStroke}"
                                           FontSize="12" />
                                </Grid>
                                <Border Grid.Row="1"
                                        Margin="-10,0,-10,0"
                                        Stroke="{DynamicResource CalcAccentStroke}"
                                        StrokeThickness="1"
                                        BackgroundColor="{DynamicResource CalcDropdownBackground}"
                                        IsVisible="False"
                                        x:Name="HourlyOptionsBorder">
                                    <VerticalStackLayout x:Name="HourlyOptionsPanel"
                                                         Spacing="0" />
                                </Border>
                            </Grid>
                        </Border>

                        <Label x:Name="TravelTypeLabel"
                               Text="Valitse matkatyyppi"
                               FontSize="14"
                               FontAttributes="Bold"
                               Style="{StaticResource BodyLabelStyle}" />
                        <Border Style="{StaticResource InputBorderStyle}" Padding="10,0">
                            <Grid RowDefinitions="44,Auto">
                                <Grid HeightRequest="44">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnMileageDropdownTapped" />
                                    </Grid.GestureRecognizers>
                                    <Label x:Name="MileageSelectedLabel"
                                           Style="{StaticResource DropdownHeaderTextStyle}" />
                                    <Label Text="▼"
                                           HorizontalOptions="End"
                                           VerticalOptions="Center"
                                           TextColor="{DynamicResource CalcAccentStroke}"
                                           FontSize="12" />
                                </Grid>
                                <Border Grid.Row="1"
                                        Margin="-10,0,-10,0"
                                        Stroke="{DynamicResource CalcAccentStroke}"
                                        StrokeThickness="1"
                                        BackgroundColor="{DynamicResource CalcDropdownBackground}"
                                        IsVisible="False"
                                        x:Name="MileageOptionsBorder">
                                    <VerticalStackLayout x:Name="MileageOptionsPanel"
                                                         Spacing="0" />
                                </Border>
                            </Grid>
                        </Border>

                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0"
                                                 Spacing="6">
                                <Label x:Name="HoursInputLabel"
                                       Text="Työtunnit (h)"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       Style="{StaticResource BodyLabelStyle}" />
                                <Border Style="{StaticResource InputBorderStyle}">
                                    <Entry x:Name="HoursEntry"
                                           Placeholder="0"
                                           Style="{StaticResource InputEntryStyle}"
                                           Keyboard="Numeric"
                                           TextChanged="OnTextChanged" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="6">
                                <Label x:Name="KilometersInputLabel"
                                       Text="Ajokilometrit (km)"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       Style="{StaticResource BodyLabelStyle}" />
                                <Border Style="{StaticResource InputBorderStyle}">
                                    <Entry x:Name="KilometersEntry"
                                           Placeholder="0"
                                           Style="{StaticResource InputEntryStyle}"
                                           Keyboard="Numeric"
                                           TextChanged="OnTextChanged" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <Label x:Name="ValidationLabel"
                               TextColor="{DynamicResource CalcError}"
                               FontSize="12"
                               IsVisible="False" />

                    </VerticalStackLayout>
                </Border>


            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
