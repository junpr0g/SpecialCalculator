<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SpecialCalculator.MainPage"
             BackgroundColor="#F4F8F4">
    <ContentPage.Resources>
        <Style x:Key="InputBorderStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#F7FBF7" />
            <Setter Property="Stroke" Value="#2F6B4A" />
            <Setter Property="StrokeThickness" Value="1.2" />
            <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            <Setter Property="Padding" Value="10,4" />
        </Style>

        <Style x:Key="InputEntryStyle" TargetType="Entry">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="#153D2B" />
            <Setter Property="PlaceholderColor" Value="#90A39A" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="HeightRequest" Value="44" />
        </Style>

        <Style x:Key="DropdownHeaderTextStyle" TargetType="Label">
            <Setter Property="TextColor" Value="#153D2B" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="LineBreakMode" Value="TailTruncation" />
        </Style>

        <Style x:Key="DropdownOptionTextStyle" TargetType="Label">
            <Setter Property="TextColor" Value="#0E3726" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </ContentPage.Resources>
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">
            <Border BackgroundColor="#E8F0E8"
                    Stroke="#CEDDCE"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    HeightRequest="112"
                    Padding="16">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Image Source="cabin_icon.png"
                           Grid.ColumnSpan="2"
                           Aspect="AspectFill"
                           Opacity="0.14"
                           HorizontalOptions="Fill"
                           VerticalOptions="Fill"
                           Margin="-10,-8,-10,-8"
                           InputTransparent="True"
                           SemanticProperties.Description="Mökki ja mänty taustakuvio" />

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Lapin Koti- ja Mökkiyhdistys ry"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="#1F5A3B" />
                        <Label Text="Palvelukustannuslaskuri"
                               FontSize="13"
                               TextColor="#5F7165" />
                    </VerticalStackLayout>

                    <Button Grid.Column="1"
                            Text="Asetukset"
                            Clicked="OnOpenSettingsClicked"
                            BackgroundColor="#DDE8DD"
                            TextColor="#1F5A3B"
                            BorderColor="#2F6B4A"
                            BorderWidth="1"
                            CornerRadius="8"
                            HeightRequest="36"
                            FontSize="13"
                            Padding="12,0"
                            VerticalOptions="Start"
                            HorizontalOptions="End"
                            SemanticProperties.Hint="Avaa ylläpidon asetukset" />
                </Grid>
            </Border>

            <Grid x:Name="CardsGrid"
                  ColumnDefinitions="*"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="12"
                  RowSpacing="12">
                <Border x:Name="ResultsCard"
                        Grid.Row="0"
                        BackgroundColor="White"
                        Stroke="#CEDDCE"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Laskelman erittely"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="#1F5A3B" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Työ (alv 0 %)" TextColor="#1F5A3B" />
                            <Label x:Name="WorkValueLabel"
                   Grid.Column="1"
                   FontAttributes="Bold"
                   TextColor="#1F5A3B"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Matka (alv 0 %)" TextColor="#1F5A3B" />
                            <Label x:Name="TravelValueLabel"
                   Grid.Column="1"
                   FontAttributes="Bold" 
                   TextColor="#1F5A3B"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Subtotal (alv 0 %)" TextColor="#1F5A3B"/>
                            <Label x:Name="SubtotalValueLabel"
                   Grid.Column="1"
                   FontAttributes="Bold"
                   TextColor="#1F5A3B"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label x:Name="VatCaptionLabel" TextColor="#1F5A3B"/>
                            <Label x:Name="VatValueLabel"
                   Grid.Column="1"
                   FontAttributes="Bold"
                   TextColor="#1F5A3B"/>
                        </Grid>

                        <Border BackgroundColor="#E8F0E8"
                StrokeShape="RoundRectangle 10"
                Padding="12"
                Margin="0,8,0,0">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="YHTEENSÄ"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="#1F5A3B" />
                                <Label x:Name="TotalValueLabel"
                       Grid.Column="1"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="#1F5A3B" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="InputCard"
                        Grid.Row="1"
                        BackgroundColor="#E8F0E8"
                        Stroke="#CEDDCE"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="12">
                            <Label Text="Syötä tiedot"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="#1F5A3B"
                                   VerticalOptions="Center" />
                            <Button Grid.Column="1"
                                    Text="Tyhjennä"
                                    Clicked="OnResetClicked"
                                    BackgroundColor="Transparent"
                                    TextColor="#1F5A3B"
                                    BorderColor="#2F6B4A"
                                    BorderWidth="1"
                                    CornerRadius="8"
                                    HeightRequest="36"
                                    FontSize="13"
                                    Padding="12,0"
                                    VerticalOptions="Center"
                                    HorizontalOptions="End"
                                    SemanticProperties.Hint="Tyhjentää syötetyt arvot ja palauttaa oletukset" />
                        </Grid>

                        <Label Text="Valitse työtyyppi"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#2F4736" />
                        <Border Style="{StaticResource InputBorderStyle}" Padding="10,0">
                            <Grid RowDefinitions="44,Auto">
                                <Grid HeightRequest="44">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnHourlyDropdownTapped" />
                                    </Grid.GestureRecognizers>
                                    <Label x:Name="HourlySelectedLabel"
                                           Style="{StaticResource DropdownHeaderTextStyle}" />
                                    <Label Text="▼"
                                           HorizontalOptions="End"
                                           VerticalOptions="Center"
                                           TextColor="#2F6B4A"
                                           FontSize="12" />
                                </Grid>
                                <Border Grid.Row="1"
                                        Margin="-10,0,-10,0"
                                        Stroke="#2F6B4A"
                                        StrokeThickness="1"
                                        BackgroundColor="#F2F8F2"
                                        IsVisible="False"
                                        x:Name="HourlyOptionsBorder">
                                    <VerticalStackLayout x:Name="HourlyOptionsPanel"
                                                         Spacing="0" />
                                </Border>
                            </Grid>
                        </Border>

                        <Label Text="Valitse matkatyyppi"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#2F4736" />
                        <Border Style="{StaticResource InputBorderStyle}" Padding="10,0">
                            <Grid RowDefinitions="44,Auto">
                                <Grid HeightRequest="44">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnMileageDropdownTapped" />
                                    </Grid.GestureRecognizers>
                                    <Label x:Name="MileageSelectedLabel"
                                           Style="{StaticResource DropdownHeaderTextStyle}" />
                                    <Label Text="▼"
                                           HorizontalOptions="End"
                                           VerticalOptions="Center"
                                           TextColor="#2F6B4A"
                                           FontSize="12" />
                                </Grid>
                                <Border Grid.Row="1"
                                        Margin="-10,0,-10,0"
                                        Stroke="#2F6B4A"
                                        StrokeThickness="1"
                                        BackgroundColor="#F2F8F2"
                                        IsVisible="False"
                                        x:Name="MileageOptionsBorder">
                                    <VerticalStackLayout x:Name="MileageOptionsPanel"
                                                         Spacing="0" />
                                </Border>
                            </Grid>
                        </Border>

                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0"
                                                 Spacing="6">
                                <Label Text="Työtunnit (h)"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#2F4736" />
                                <Border Style="{StaticResource InputBorderStyle}">
                                    <Entry x:Name="HoursEntry"
                                           Placeholder="0"
                                           Style="{StaticResource InputEntryStyle}"
                                           Keyboard="Numeric"
                                           TextChanged="OnTextChanged" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="6">
                                <Label Text="Ajokilometrit (km)"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#2F4736" />
                                <Border Style="{StaticResource InputBorderStyle}">
                                    <Entry x:Name="KilometersEntry"
                                           Placeholder="0"
                                           Style="{StaticResource InputEntryStyle}"
                                           Keyboard="Numeric"
                                           TextChanged="OnTextChanged" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <Label x:Name="ValidationLabel"
                               TextColor="#B42318"
                               FontSize="12"
                               IsVisible="False" />

                    </VerticalStackLayout>
                </Border>


            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
